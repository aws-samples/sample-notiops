    { "key": "nav:inspection:high-load", "level": "subtab", "parent": "nav:inspection",
      "responseKey": "by_severity", "title_zh": "高负载", "title_en": "High Load",
      "routes": [{ "method": "GET", "pattern": "/inspection/findings$", "queryMatch": { "kind": "high_load" } }] },
    { "key": "nav:inspection:idle", "level": "subtab", "parent": "nav:inspection",
