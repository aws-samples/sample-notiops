    { "key": "nav:inspection", "level": "tab", "viewState": "inspection",
      "title_zh": "资源巡检", "title_en": "Resource Inspection",
      "_note": "tab 只挂「总览 + 明细 + 序列」三条：它们是任何子页都要用的公共读取。列表按 kind 分权到子页（见下），SHALL NOT 把 /inspection/findings$ 放回这里 —— tab 级 route 会遮蔽子页的 queryMatch（matchRoute 按节点顺序取首个命中），从而绕过按页分权。",
      "routes": [
        { "method": "GET", "pattern": "/inspection/overview$" },
        { "method": "GET", "pattern": "/inspection/finding$" },
        { "method": "GET", "pattern": "/inspection/series$" }
      ] },
    { "key": "nav:inspection:overview", "level": "subtab", "parent": "nav:inspection",
