      "routes": [{ "method": "GET", "pattern": "/inspection/config$" }] },

    { "key": "nav:inspection:actions", "level": "group", "parent": "nav:inspection",
      "title_zh": "操作", "title_en": "Actions" },
    { "key": "action:inspection:scope", "level": "action", "parent": "nav:inspection:actions",
      "title_zh": "改巡检范围", "title_en": "Edit inspection scope",
      "_note": "🔴 独立于 nav:inspection。搭在 nav 上意味着任何能看看板的人都能把生产库从巡检范围里摘掉，而那个操作没有任何运行时信号 —— 下一轮就是少了那台，报告上不会写「有一台被排除了」。",
      "routes": [
        { "method": "POST", "pattern": "/inspection/scope/(high|idle)$" },
        { "method": "POST", "pattern": "/inspection/scope/(high|idle)/renew$" },
        { "method": "POST", "pattern": "/inspection/scope/(high|idle)/delete$" }
      ] },
    { "key": "action:inspection:schedule", "level": "action", "parent": "nav:inspection:actions",
      "title_zh": "改巡检定时", "title_en": "Edit inspection schedule",
      "_note": "按类型全局（R11.1），不按账号。改错时刻的后果是那一类巡检永远不被精确命中（只靠补跑），表现为报告总是晚几分钟而不是报错。",
      "routes": [{ "method": "PUT", "pattern": "/inspection/schedule/(high|idle)$" }] },
    { "key": "action:inspection:threshold", "level": "action", "parent": "nav:inspection:actions",
      "title_zh": "改判定阈值", "title_en": "Edit detection thresholds",
      "_note": "🔴 独立于 action:inspection:schedule，不合并。改时刻只影响「什么时候跑」，改阈值直接改变「什么算风险」—— 调高一档就能让一批生产告警消失，而下一轮报告上不会写「阈值被改过」。按 R6.9，配置变更还会强制 resolve 全部旧 finding 并重新计数，所以这是一个能一次性改写整个看板的操作。",
      "routes": [{ "method": "PUT", "pattern": "/inspection/rules/(high|idle)$" }] },
    { "key": "action:inspection:run", "level": "action", "parent": "nav:inspection:actions",
      "title_zh": "手动触发巡检", "title_en": "Trigger inspection run",
      "_note": "🔴 独立于 action:inspection:scope，不合并。触发 refetch 会真调 CloudWatch GetMetricData 并可能派发 DA 判读 —— 这是唯一能被前端请求直接花钱的巡检端点。与改范围合并会让「能编辑排除清单」顺带获得「能反复烧配额」。",
      "routes": [{ "method": "POST", "pattern": "/inspection/run$" },
                 { "method": "POST", "pattern": "/inspection/judge$" }] },
    { "key": "nav:inspection:resources", "level": "subtab", "parent": "nav:inspection",
      "responseKey": "resources",
      "title_zh": "资源清单", "title_en": "Resource inventory",
      "_note": "只读列举账号下的 RDS 与 ElastiCache，供排除清单勾选（替代手填 resource_id）。⚠️ 不含 EC2 —— 巡检只覆盖这两类（inspection/pipeline.py::load_resources），列 EC2 会让人勾出一条语义合法但永不匹配的排除记录。放 subtab 而不是 action：它不改任何状态，且 nav:inspection:* 的通配已覆盖，三个预置角色无需改动就能用。",
      "routes": [{ "method": "GET", "pattern": "/inspection/resources$" }] },

    { "key": "nav:customize", "level": "tab", "viewState": "customize",
      "title_zh": "自定义", "title_en": "Customize" },

