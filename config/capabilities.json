{
  "version": 1,
  "_note": "能力清单单一真源。BFF(authz/渲染) 与前端共同消费。新增 dashboard 只需在此加节点 + 在对应 BFF 模块加数据路由 + 前端加卡片渲染，三处自动生效。routes 的 pattern 为 path 后缀正则（对齐 index.mjs 的 endsWith/exec 匹配习惯）。queryMatch/bodyMatch 用于同路由按参数区分能力。responseKey 用于 dashboard 单次返回时按权限过滤顶层字段（response-side 强制）。",
  "nodes": [
    { "key": "nav:chat", "level": "tab", "viewState": "chat", "alwaysOn": true,
      "title_zh": "对话", "title_en": "Chat",
      "routes": [{ "method": "POST", "pattern": "/stream$" }] },

    { "key": "nav:notifications", "level": "tab", "viewState": "notifications",
      "title_zh": "通知", "title_en": "Notifications",
      "routes": [
        { "method": "GET",  "pattern": "/notifications$" },
        { "method": "GET",  "pattern": "/notifications/unread$" },
        { "method": "POST", "pattern": "/notifications/read$" },
        { "method": "GET",  "pattern": "/health/dashboard$" },
        { "method": "GET",  "pattern": "/health/dashboard/count$" },
        { "method": "GET",  "pattern": "/health/event$" }
      ] },
    { "key": "nav:notifications:eos", "level": "subtab", "parent": "nav:notifications",
      "title_zh": "生命周期 / EOS", "title_en": "Lifecycle / EOS",
      "routes": [{ "method": "GET", "pattern": "/lifecycle/eos$" },
        { "method": "GET", "pattern": "/lifecycle/eos/org-summary$" }] },

