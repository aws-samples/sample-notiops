{
  "name": "notiops-infra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:standalone": "cdk synth --app 'npx ts-node bin/standalone.ts' NotiOps",
    "deploy": "cdk deploy --all",
    "diff": "cdk diff",
    "test": "jest"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.243.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/source-map-support": "^0.5.10",
    "aws-cdk": "^2.1135.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "fast-xml-parser": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
